---
/**
 * Procedural sumi-e landscape: layered ink ridges, mist and pines drawn from a seed,
 * so every panel gets its own painting without any image files.
 */
interface Props { variant?: number; sun?: boolean; id?: string }
const { variant = 1, sun = false, id = `land-${variant}` } = Astro.props;

let state = variant * 131 + 7;
const rnd = () => {
  state = (state + 0x6d2b79f5) | 0;
  let t = Math.imul(state ^ (state >>> 15), 1 | state);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const ridge = (base: number, amp: number, freq: number) => {
  const p = [rnd() * 6.28, rnd() * 6.28, rnd() * 6.28];
  const pts: string[] = [];
  const ys: number[] = [];
  for (let x = 0; x <= 600; x += 10) {
    const t = x / 600;
    const n = .55 * Math.sin(t * freq * 6.28 + p[0]) + .3 * Math.sin(t * freq * 2.3 * 6.28 + p[1]) + .15 * Math.sin(t * freq * 5.1 * 6.28 + p[2]);
    const y = base - amp * Math.pow(Math.abs(n), .85) * Math.sign(n);
    ys.push(y);
    pts.push(`${x} ${y.toFixed(1)}`);
  }
  // The shape runs past the bottom edge so the rough-edge displacement never leaves gaps there.
  return { d: `M-20 470 L${pts.join(' L')} L620 470Z`, ys };
};
const far = ridge(190, 70, 1.1);
const mid = ridge(255, 58, 1.6);
const near = ridge(335, 42, 2.2);
const pines = [0, 1, 2].map(() => {
  const i = 6 + Math.floor(rnd() * 48);
  return { x: i * 10, y: near.ys[i], s: .7 + rnd() * .7 };
});
const sunX = 90 + rnd() * 420, sunY = 70 + rnd() * 50;
---

<svg viewBox="0 0 600 400" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
  <defs>
    <filter id={`${id}-rough`} x="-2%" y="-2%" width="104%" height="104%">
      <feTurbulence type="fractalNoise" baseFrequency=".045" numOctaves="2" seed={variant + 3} result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="7" xChannelSelector="R" yChannelSelector="G" />
    </filter>
    <filter id={`${id}-soft`} x="-10%" y="-30%" width="120%" height="160%"><feGaussianBlur stdDeviation="9" /></filter>
    <filter id={`${id}-haze`} x="-5%" y="-5%" width="110%" height="110%"><feGaussianBlur stdDeviation="1.4" /></filter>
  </defs>
  {sun && <circle cx={sunX} cy={sunY} r="30" fill="#9f3a2d" opacity=".92" filter={`url(#${id}-haze)`} />}
  <path d={far.d} fill="#cfc7b6" filter={`url(#${id}-haze)`} />
  <ellipse cx="170" cy="238" rx="190" ry="26" fill="#f1e9da" opacity=".7" filter={`url(#${id}-soft)`} />
  <path d={mid.d} fill="#8d877b" filter={`url(#${id}-rough)`} />
  <ellipse cx="430" cy="306" rx="220" ry="24" fill="#f1e9da" opacity=".65" filter={`url(#${id}-soft)`} />
  <path d={near.d} fill="#211e1a" filter={`url(#${id}-rough)`} />
  {pines.map(p => (
    <g transform={`translate(${p.x} ${p.y}) scale(${p.s})`} fill="#211e1a">
      <rect x="-1.2" y="-6" width="2.4" height="14" />
      <path d="M0 -42 L-9 -22 H-4 L-13 -6 H13 L4 -22 H9Z" />
    </g>
  ))}
</svg>

<style>
  svg { display: block; width: 100%; height: 100%; overflow: hidden; }
</style>
